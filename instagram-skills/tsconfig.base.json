{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@instagram-skills/instagram-aiograpi-rest": ["packages/instagram-aiograpi-rest/src/index.ts"],
      "@instagram-skills/instagram-aiograpi-rest/cli": ["packages/instagram-aiograpi-rest/src/cli.ts"],
      "@instagram-skills/instagram-connector": ["packages/instagram-connector/src/index.ts"],
      "@instagram-skills/instagram-profile-setup": ["packages/instagram-profile-setup/src/index.ts"],
      "@instagram-skills/instagram-video-interaction": ["packages/instagram-video-interaction/src/index.ts"],
      "@instagram-skills/instagram-warmup-orchestrator": ["packages/instagram-warmup-orchestrator/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
